{
  "info": {
    "_postman_id": "b6c4756a-4c3e-4e8d-a5a2-f253254a24de",
    "name": "BankX Calidad - Transacciones",
    "description": "Pruebas del endpoint reactivo para simular débitos y créditos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8084"
    }
  ],
  "item": [
    {
      "name": "Débito exitoso",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"DEBIT\",\n  \"amount\": 100,\n  \"balance\": 500\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/transactions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "transactions"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200 y calcula el saldo del débito', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json()).to.deep.equal({ status: 'OK', newBalance: 400 });",
              "});"
            ]
          }
        }
      ]
    },
